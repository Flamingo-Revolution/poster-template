{
  "name": "flamingo-times-cover-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone browser studio for Flamingo Times cover and poster exports.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:vendor": "node scripts/prepare-vendor.js",
    "serve": "node scripts/serve.js",
    "test": "npm run test:static && npm run test:e2e",
    "test:static": "node scripts/static-check.js",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
